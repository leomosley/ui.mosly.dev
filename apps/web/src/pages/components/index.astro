---
import { ComponentSearch } from "@/components/site/component-search";
import Base from "@/layouts/Base.astro";
---

<Base
  title="Components"
  description="Every shadcn component in the Mosly theme."
>
  <main class="mx-auto max-w-7xl px-4 pt-20 sm:px-6 sm:pt-28">
    <div class="mb-14 max-w-3xl">
      <h1 class="text-4xl font-semibold tracking-[-0.04em] sm:text-6xl">
        Every component, themed.
      </h1>
      <p class="text-muted-foreground mt-5 max-w-2xl text-lg leading-relaxed">
        The full shadcn set, plus form, combobox, date-picker, and data-table compositions.
      </p>
    </div>
    <ComponentSearch client:load />
  </main>
</Base>
